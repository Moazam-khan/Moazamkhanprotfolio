{
  "name": "moazam-khan-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src scripts tests *.json *.ts *.md"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "postcss": "8.5.32"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "prettier": "3.6.2",
    "typescript": "^5.8.0"
  }
}
